# Managed by Ansible (role: security_hardening)

# sshd-socket-generator turns this into ssh.socket's ListenStream on
# daemon-reload; sshd itself never binds the port.
Port {{ ssh_port }}

PermitRootLogin no
PasswordAuthentication no
PubkeyAuthentication yes

# Ubuntu defaults to six tries and a two-minute grace, which is generous for a
# host that only ever accepts keys.
MaxAuthTries 4
LoginGraceTime 20

AllowAgentForwarding no
X11Forwarding no

AllowUsers {{ ssh_allowed_users }}

{% if backup_enabled | bool %}
# The NAS holds this key. Without forwarding it reaches sshd and nothing else;
# with it, Postgres and every loopback-only service are one tunnel away.
Match User {{ backup_pull_user }}
    AllowTcpForwarding no
{% endif %}
