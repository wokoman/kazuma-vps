{
    email {{ caddy_email }}
}

# Every vhost is published to Certificate Transparency logs within minutes of
# its certificate being issued, so scanners arrive uninvited and constantly.
# They are harmless; they just drown the logs.
(no_scanner_logs) {
    @scanners path_regexp (?i)^/(\.env|\.git|\.aws|\.ssh|wp-|wordpress|xmlrpc\.php|phpmyadmin|vendor/|cgi-bin/|actuator|owa/|autodiscover)
    log_skip @scanners
}

{{ site_domain }} {
    root * {{ website_dest }}
    encode zstd gzip
    file_server
    import no_scanner_logs
    log
}

www.{{ site_domain }} {
    redir https://{{ site_domain }}{uri}
}

{% if miniflux_enabled %}
{{ miniflux_domain }} {
    reverse_proxy 127.0.0.1:{{ miniflux_listen_port }}
    import no_scanner_logs
    log
}
{% endif %}

{% if forgejo_enabled %}
{{ forgejo_domain }} {
    reverse_proxy 127.0.0.1:{{ forgejo_http_port }}
    header X-Robots-Tag "noindex, nofollow"
    import no_scanner_logs
    log
}
{% endif %}

{% if ose_site_enabled %}
{{ ose_site_domain }}, video.{{ site_domain }} {
    root * {{ ose_site_dest }}
    encode zstd gzip
    file_server

    # The videos live on the NAS; this box keeps only the player page.
    # handle_path strips /videos, so the NAS serves them from its own root.
    handle_path /videos/* {
        # Filenames carry the year, so a given URL never changes content.
        header Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy {{ ose_site_video_origin }} {
            header_down -Server
            # Upstream error bodies pass straight through by default, which
            # would hand visitors Synology's error page. Re-raise as our own.
            # Spelled out per status: `error {rp.status_code}` is read as a
            # message, not a code, and silently becomes a 500.
            @upstream_missing status 404
            handle_response @upstream_missing {
                error 404
            }
            @upstream_broken status 5xx
            handle_response @upstream_broken {
                error 502
            }
        }
    }

    # An unreachable NAS should read as a sentence, not as 502. Only 5xx:
    # a request for a year that does not exist deserves an honest 404.
    handle_errors 5xx {
        rewrite * /unavailable.html
        file_server
    }

    # Only requests that reach a video say anything about real viewers.
    # log_skip is ordered before handle_path, so this sees the full path.
    @notvideo not path /videos/*
    log_skip @notvideo

    log {
        output file /var/log/caddy/1se-access.log {
            roll_size 10mb
            roll_keep 3
        }
    }

    # Prevent indexing by search engines
    header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"

    # Block common bots and crawlers
    @bots {
        header_regexp User-Agent (?i)(googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|sogou|exabot|facebookexternalhit|facebot|ia_archiver|alexa|msnbot|archive\.org_bot|semrushbot|ahrefsbot|mj12bot|dotbot|petalbot|bytespider|gptbot|claudebot|anthropic|ccbot)
    }
    respond @bots 403

    # Handle robots.txt
    handle /robots.txt {
        respond "User-agent: *
Disallow: /
"
    }

    # Suppress favicon 404s
    handle /favicon.ico {
        respond 204
    }
}
{% endif %}

# Catch-all HTTP on port 80 → redirect to apex
:80 {
    redir https://{{ site_domain }}{uri}
}
